# Port number for backend service
PORT=5000

# MongoDB Connection String URI
MONGODB_URI=mongodb://localhost:27017/aidentalcare

# JWT signing secret
JWT_SECRET=generate_a_secure_64_byte_hex_string_here

# JWT token expiry (e.g. 15m, 24h)
JWT_EXPIRE=24h

# Transactional Email Server Credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Gemini AI Platform Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name used for dental scan analysis. Google periodically retires
# older model versions — if AI analysis starts failing with a 404 "model not found"
# error, check https://ai.google.dev/gemini-api/docs/models for the current
# recommended model and update this value (no code change needed).
GEMINI_MODEL=gemini-3.5-flash-lite

# Application Configuration Environment (production/development)
NODE_ENV=production

# Frontend Client Origin URL
CLIENT_URL=http://localhost:5173

# Admin credentials (used for seeding the admin account)
ADMIN_EMAIL=admin@healthcare.com
ADMIN_PASSWORD=set_a_strong_admin_password_here
