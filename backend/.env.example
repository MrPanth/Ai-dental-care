# Port number for backend service
PORT=5001

# MongoDB Connection String URI
MONGO_URI=mongodb://localhost:27017/aidentalcare

# JWT signing secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Transactional Email Server Credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Gemini AI Platform Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration Environment (production/development)
NODE_ENV=production

# Frontend Client Origin URL
CLIENT_URL=http://localhost:5173

# Redis configuration (optional for local fallback, required in production)
REDIS_HOST=localhost
REDIS_PORT=6379
